{"rn": "amafaranga ijana na mirongwibiri n'ane", "en": "124 francs", "fr": "124 francs", "source": "Livre I, leçon 38", "fiabilite": "sûr", "note": ""}
{"rn": "abagabo ijana na mirongwitatu na babiri", "en": "132 men", "fr": "132 hommes", "source": "Livre I, leçon 38", "fiabilite": "sûr", "note": ""}
{"rn": "Abantu bangahe bariho?", "en": "How many people are here?", "fr": "Combien de personnes y a-t-il ici ?", "source": "Livre I, leçon 39", "fiabilite": "sûr", "note": ""}
{"rn": "Umutunzi afise inka zingahe?", "en": "How many cows does the rich man have?", "fr": "Combien de vaches a le riche ?", "source": "Livre I, leçon 39", "fiabilite": "sûr", "note": "-ngahe se met après le nom."}
{"rn": "Nzotuma umuntu i Gitega.", "en": "I will send a person to Gitega.", "fr": "J'enverrai quelqu'un à Gitega.", "source": "Livre I, leçon 39", "fiabilite": "sûr", "note": "gutuma : envoyer une personne avec un message."}
{"rn": "Nzorungika ivyete vyanje i Gitega.", "en": "I will send my letters to Gitega.", "fr": "J'enverrai mes lettres à Gitega.", "source": "Livre I, leçon 39", "fiabilite": "sûr", "note": "kurungika : envoyer une chose."}
{"rn": "Sinumva ikirundi.", "en": "I don't understand Kirundi.", "fr": "Je ne comprends pas le kirundi.", "source": "Livre I, leçon 39", "fiabilite": "sûr", "note": ""}
