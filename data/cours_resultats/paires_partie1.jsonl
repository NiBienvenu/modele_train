{"rn": "Ukwizera kwawe kuri hehe?", "en": "Where is your faith?", "fr": "Où est ta foi ?", "source": "Livre I, leçon 32", "fiabilite": "sûr", "note": ""}
{"rn": "Ukugaruka kwiwe", "en": "his return", "fr": "son retour", "source": "Livre I, leçon 32", "fiabilite": "sûr", "note": ""}
{"rn": "Hano ni neza.", "en": "Here it is good.", "fr": "Ici, c'est bien.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Ni habi cane.", "en": "It is a very bad place.", "fr": "C'est un très mauvais endroit.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Hariya hitwa Gitega.", "en": "That place over there is called Gitega.", "fr": "Là-bas, ça s'appelle Gitega.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Harashushe.", "en": "It is hot.", "fr": "Il fait chaud.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Haza umugabo.", "en": "There comes a man.", "fr": "Voilà un homme qui vient.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Hariho ibijumbu?", "en": "Are there any sweet potatoes?", "fr": "Y a-t-il des patates douces ?", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Ego, biriho.", "en": "Yes, there are.", "fr": "Oui, il y en a.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": "Le verbe s'accorde avec ibijumbu (bi-)."}
{"rn": "Nta biriho.", "en": "There are none.", "fr": "Il n'y en a pas.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "Har' amazi menshi hano.", "en": "There is much water here.", "fr": "Il y a beaucoup d'eau ici.", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": ""}
{"rn": "mu maso hiwe", "en": "his face", "fr": "son visage", "source": "Livre I, leçon 33", "fiabilite": "sûr", "note": "Pas d'autre mot pour « visage » : amaso + possessif en ha-."}
{"rn": "Nzokwandika.", "en": "I shall write.", "fr": "J'écrirai.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": "Localement aussi nzandika."}
{"rn": "Azokwibuka.", "en": "He/she will remember.", "fr": "Il (elle) se souviendra.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": "Localement aussi azibuka."}
{"rn": "Sinzokwibagira.", "en": "I shall not forget.", "fr": "Je n'oublierai pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntazokwubaka.", "en": "He/she will not build.", "fr": "Il (elle) ne construira pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Sinibuka.", "en": "I don't remember.", "fr": "Je ne me souviens pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntiwibuka.", "en": "You don't remember.", "fr": "Tu ne te souviens pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntiyibuka.", "en": "He/she doesn't remember.", "fr": "Il (elle) ne se souvient pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntitwibuka.", "en": "We don't remember.", "fr": "Nous ne nous souvenons pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntiyambara.", "en": "He/she doesn't wear.", "fr": "Il (elle) ne porte pas (de vêtement).", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntiyemera.", "en": "He/she doesn't agree.", "fr": "Il (elle) n'est pas d'accord.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
{"rn": "Ntiyubaka.", "en": "He/she doesn't build.", "fr": "Il (elle) ne construit pas.", "source": "Livre I, leçon 36", "fiabilite": "sûr", "note": ""}
